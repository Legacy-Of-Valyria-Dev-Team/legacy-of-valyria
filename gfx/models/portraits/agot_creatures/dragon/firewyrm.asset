pdxmesh = {
	name = "firewyrm_mesh"
	file = "firewyrm.mesh"
	scale = 1.0

	import = {
		type = skeletal_animation_set
		name = "dragon_animations"
	}

	additive_animation = { 	id = "dragon_infant_proportions"			type = "dragon_infant.anim" }
	additive_animation = { 	id = "dragon_large_proportions"				type = "dragon_large.anim" }

	additive_animation = { 	id = "dragon_neck_length"					type = "dragon_neck_length.anim" }
	additive_animation = { 	id = "dragon_tail_length"					type = "dragon_tail_length.anim" }
	additive_animation = { 	id = "dragon_body_shape"					type = "dragon_body_shape.anim" }

	meshsettings = {
		name = "body"
		index = 0
		texture_diffuse = "dragon_body_diffuse.dds"
		texture_normal = "dragon_body_normal.dds"
		texture_specular = "dragon_body_properties.dds"
		texture = { file = "dragon_body_mask.dds" index = 3 }
		shader = "portrait_dragon_decals"
		shader_file = "gfx/FX/jomini/portrait.shader"
		additional_shader_defines = { "DRAGON_BODYPART_MARKER float3(1.0f,0.0f,0.0f)" }
	}

	meshsettings = {
		name = "wings"
		index = 0
		texture_diffuse = "dragon_wing_diffuse.dds"
		texture_normal = "dragon_wing_normal.dds"
		texture_specular = "dragon_wing_properties.dds"
		texture = { file = "dragon_wing_mask.dds" index = 3 }
		shader = "portrait_dragon_wing_decals"
		shader_file = "gfx/FX/jomini/portrait.shader"
		additional_shader_defines = { "DRAGON_BODYPART_MARKER float3(0.0f,0.0f,1.0f)" }
	}

	meshsettings = {
		name = "eye"
		index = 0
		texture_diffuse = "dragon_eye_inside_diffuse.dds"
		texture_normal = "dragon_eye_inside_normal.dds"
		texture_specular = "dragon_eye_inside_properties.dds"
		texture = { file = "dragon_eye_mask.dds" index = 3 }
		shader = "portrait_dragon_decals"
		shader_file = "gfx/FX/jomini/portrait.shader"
		additional_shader_defines = { "DRAGON_BODYPART_MARKER float3(0.0f,1.0f,1.0f)" }
	}

	meshsettings = {
		name = "horns"
		index = 0
		texture_diffuse = "dragon_horns_diffuse.dds"
		texture_normal = "dragon_horns_normal.dds"
		texture_specular = "no_properties.dds"
		texture = { file = "dragon_horns_mask.dds" index = 3 }
		shader = "portrait_dragon_decals"
		shader_file = "gfx/FX/jomini/portrait.shader"
		additional_shader_defines = { "DRAGON_BODYPART_MARKER float3(1.0f,1.0f,0.0f)" }
	}
}

entity = {
	name = "firewyrm_entity"
	pdxmesh = "firewyrm_mesh"
	
    game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	 }
	 
	attribute = { name = "dragon_infant_proportions" 			additive_animation = "dragon_infant_proportions" default = 0.5 }
	attribute = { name = "dragon_large_proportions" 			additive_animation = "dragon_large_proportions" default = 0.5 }
	
	attribute = { name = "dragon_neck_length" 			additive_animation = "dragon_neck_length" default = 0.0 }
	attribute = { name = "dragon_tail_length" 			additive_animation = "dragon_tail_length" default = 0.0 }
	attribute = { name = "dragon_body_shape" 			additive_animation = "dragon_body_shape" default = 0.0 }

	get_state_from_parent = yes

	state = {	name = "dragon_static"						animation = "dragon_idle_1" 					looping = no animation_speed = 1.0 }
	state = {	name = "dragon_idle_entry"					animation = "dragon_idle_flair_lookingleft" 	looping = no animation_speed = 1.0 }
	state = {	name = "dragon_idle"						animation = "dragon_idle_1" 					looping = no animation_speed = 1.0 }
	state = {	name = "dragon_flying"						animation = "dragon_flying_1" 					looping = no animation_speed = 1.0 }
	state = {	name = "dragon_flying_2"					animation = "dragon_flying_2" 					looping = no animation_speed = 1.0 }
	state = {	name = "dragon_roar"						animation = "dragon_roar_1" 					looping = no animation_speed = 1.0 }
	state = {	name = "dragon_hover"						animation = "dragon_hover_1" 					looping = no animation_speed = 1.0 }
}

pdxmesh = {
	name = "firewyrm_shadow_mesh"
	file = "firewyrm.mesh"
	scale = 1.0

	import = {
		type = skeletal_animation_set
		name = "dragon_animations"
	}

	additive_animation = { 	id = "dragon_infant_proportions"			type = "dragon_infant.anim" }
