	## At location
	# VALYRIA
	background = {
		trigger = {
			scope:host.location = scope:activity.activity_location
			scope:host.location = { is_coastal = yes }
		}
		texture = "gfx/interface/illustrations/event_scenes/docks.dds"
		environment = "environment_bp2_university"
		ambience = "event:/SFX/Events/Backgrounds/BP2/bp2_university"
	}
	background = {
		trigger = {
			scope:host.location = scope:activity.activity_location
			scope:host.location = {
				OR = {
					geographical_region = world_valyria_proper
					geographical_region = world_valyria_lands_of_the_long_summer
				}
				OR = {
					agot_is_urban_terrain = yes
					has_building_or_higher = large_ruined_holding_01
				}
			}
		}
		texture = "gfx/interface/illustrations/event_scenes/lv_valyria_large.dds"
		environment = "environment_valyria"
		ambience = "event:/SFX/Events/Backgrounds/BP2/bp2_university"
		music = "mood_harrenhal_laughter" # Valyria gets spooky Harrenhal music
	}
