	theme = wanderer_journey_focus

	# Remove once implemented pls
	orphan = yes

	left_portrait = {
		character = root
		animation = thinking
	}

	option = {
		name = lv_expedition_progress_event.0003.a
		custom_tooltip = lv_expedition_progress_event.0003.a.tt
		# Add debuff to the expedition or at least those involved
	}
}

# Seal the Passage
lv_expedition_progress_event.0004 = {
	type = character_event
	title = lv_expedition_progress_event.0004.t
	desc = lv_expedition_progress_event.0004.desc
	theme = wanderer_journey_focus

	# Remove once implemented pls
	orphan = yes

	left_portrait = {
		character = root
		animation = thinking
	}

	# Hmmm
	option = {
		name = lv_expedition_progress_event.0004.a
		custom_tooltip = lv_expedition_progress_event.0004.a.tt
		involved_activity = {
			activity_location = {
				if = {
					limit = { has_building = unexplored_caves_01 }
					remove_building = unexplored_caves_01
				}
				else_if = {
					limit = { has_building = unexplored_caves_02 }
					remove_building = unexplored_caves_02
				}
				else_if = { # This shouldn't be a thing but clear just to be safe
					limit = { has_building = unexplored_caves_03 }
					remove_building = unexplored_caves_03
				}
				hidden_effect = {
					lv_blocker_cleared_effect = yes
					remove_variable = blocker_outcome
				}
			}
		}
	}
}

