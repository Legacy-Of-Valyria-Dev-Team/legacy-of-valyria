		}
		#End Dynamic Camera Zoom
	}

	widgets = {
		widget = {
			gui = "agot_shader_event_sparks"
			container = "agot_shader_event_foreground"
		}
	}

	immediate = {
		play_music_cue = CK3AGOT_dragonflight_wonder_interrupted
		create_character = {
			location = location
			template = cob_final_boss_dragon_template
			random_traits = no
			location = root.location
			save_scope_as = lokiria_dragon
		}
		root = { add_character_flag = need_military_outfit }
		random_living_dragon = {
			limit = {
				has_trait = dragon_cannibal
				NOT = { has_character_flag = owned_dragon }
				location = { duchy = root.location.duchy }
				can_dragon_chomp = {
					CHOMPING_DRAGON = this
					CHOMPED_DRAGON = root.var:current_dragon
				}
			}
			save_scope_as = lokiria_dragon
		}
		scope:lokiria_dragon = { agot_set_dragon_animation_flag_effect = { FLAG = dragon_roar RIDING_DRAGON = NO } }
	}

	option = {
		# name = cob_dragon_event.0101.a
		# custom_tooltip = cob_dragon_event.0101.a_tt
		name = cob_7899_scenerio.0499.a
		custom_tooltip = cob_7899_scenerio.0499.a_tt
		add_prestige = 500
	}

	after = {
		hidden_effect = {
			if = {
				limit = {
					scope:cannibal_dragon = {
						is_alive = yes
					}
				}
				scope:cannibal_dragon = {
					death = {
						death_reason = death_vanished
					}
				}
			}
		}
		root = { remove_character_flag = need_military_outfit }
	}
}

