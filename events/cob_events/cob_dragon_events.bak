################################
#### Dragon Encounter Chain ####
################################

cob_dragon_event.0100 = { # Fear as a dragon decends!
	type = character_event
	window = cob_dragon_character_event
	title = cob_dragon_event.0100.t
	desc = cob_dragon_event.0100.desc

	theme = dragon

	override_background = {
		reference = battlefield
	}

	override_effect_2d = {
		reference = smoke
	}

	left_portrait = {
		character = root
		animation = fear
		camera = cob_camera_human_dragon_duel
	}

	right_portrait = {
		character = scope:cannibal_dragon
		camera = camera_slay_dragon_event_right
		animation = dragon_main
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_ten_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_1.0 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_nine_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.9 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_eight_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.8 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_seven_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.7 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_six_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.6 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_five_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.5 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_four_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.4 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_three_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.3 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_two_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.2 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_one_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.1 }
		}
		triggered_outfit = {
			trigger = {
				scope:cannibal_dragon = { level_zero_dragon_size_trigger = yes }
			}
			outfit_tags = { dragonrider dynamic_camera_zoom_0.0 }
		}
		#End Dynamic Camera Zoom
	}

	widgets = {
		widget = {
			gui = "agot_shader_event_sparks"
			container = "agot_shader_event_foreground"
		}
		widget = {
			gui = "agot_shader_event_fire"
			container = "agot_shader_event_background"
		}
	}

	immediate = {
		play_music_cue = CK3AGOT_dragonflight_wonder_interrupted
		create_character = {
			location = location
			template = cob_cannibal_dragon_template
			random_traits = no
			location = root.location
			save_scope_as = cannibal_dragon
		}
		character:root = {
			save_scope_as = root
		}
		random_living_dragon = {
			limit = {
				has_trait = dragon_cannibal
				NOT = { has_character_flag = owned_dragon }
				location = { duchy = root.location.duchy }
				can_dragon_chomp = {
					CHOMPING_DRAGON = this
					CHOMPED_DRAGON = root.var:current_dragon
				}
			}
			save_scope_as = cannibal_dragon
		}
		scope:cannibal_dragon = { agot_set_dragon_animation_flag_effect = { FLAG = dragon_hover RIDING_DRAGON = NO } }
	}

	option = {
		name = cob_dragon_event.0100.a
		custom_tooltip = cob_dragon_event.0100.a_tt
		add_prestige = 500
	}

	after = {
		hidden_effect = {
			if = {
				limit = {
					scope:cannibal_dragon = {
						is_alive = yes
					}
				}
				scope:cannibal_dragon = {
					death = {
						death_reason = death_vanished
					}
				}
			}
		}
	}
}

